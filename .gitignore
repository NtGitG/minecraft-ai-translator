# ========================================
# RÈGLES FINALES
# ========================================
# Toujours inclure les fichiers de documentation
!*.md
!wiki/**/*

# Toujours inclure les fichiers de configuration Gradle
!gradle.properties
!build.gradle
!settings.gradle

# Toujours inclure les wrappers Gradle
!gradlew*
!gradle/wrapper/*

# Toujours inclure les ressources du mod
!src/main/resources/**
!assets/**

# Toujours inclure les fichiers de licence
!LICENSE*
!COPYING*

# Brouillons locaux (apres !*.md)
Description.md

